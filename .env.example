# ==============================================================================
# Cynbit AI Business Intelligence & Lead Automation Agent - Environment Config
# ==============================================================================

# Gemini / LLM API Key (Optional: system provides deterministic heuristic fallback if absent)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=True

# Frontend Configuration
FRONTEND_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

# Scoring & Automation Settings
MIN_TIER_1_THRESHOLD=80
MIN_TIER_2_THRESHOLD=60
MIN_TIER_3_THRESHOLD=40

# Environment Mode: development | staging | production
ENVIRONMENT=development
